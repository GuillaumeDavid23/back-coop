{% extends 'base.html.twig' %}

{% block title %}Choisir un site - CLCOM Events{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="card wide">
        <div class="topbar">
            <h1>Bienvenue {{ app.user.email }}</h1>
            <div>
                {% if isSuperAdmin %}
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\SiteCrudController') }}" class="muted-link">Gérer les sites</a> ·
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}" class="muted-link">Gérer les utilisateurs</a> ·
                    {# ea_url() et non path() : le gabarit des logs étend la mise
                       en page d'EasyAdmin, qui exige d'être atteinte par son
                       indirection - un lien direct produit une erreur 500. #}
                    <a href="{{ ea_url().setRoute('admin_logs') }}" class="muted-link">Logs</a> ·
                {% endif %}
                <a href="{{ path('app_logout') }}" class="muted-link">Déconnexion</a>
            </div>
        </div>

        {% if sites is empty %}
            <p class="empty">Aucun site ne vous est encore attribué. Contactez un administrateur.</p>
        {% else %}
            {# Filtrage côté navigateur : la liste tient en mémoire et le résultat
               est instantané, sans aller-retour serveur. #}
            <div class="site-search">
                <span class="icon">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </span>
                <input type="search" id="site-filter" placeholder="Rechercher un site par nom ou par adresse…" autocomplete="off" autofocus
                       aria-label="Rechercher un site" aria-controls="site-grid">
            </div>

            <p class="site-search-count" id="site-count" aria-live="polite">
                {{ sites|length }} site{{ sites|length > 1 ? 's' : '' }}
            </p>

            <div class="site-grid" id="site-grid">
                {% for site in sites %}
                    <a class="site-card"
                       href="{{ path('admin_site_context', {id: site.id}) }}"
                       data-search="{{ (site.name ~ ' ' ~ site.domain ~ ' ' ~ site.code)|lower }}">
                        <span class="initials">{{ site.name|split(' ')|map(w => w|first)|join('')|slice(0, 2)|upper }}</span>
                        <span class="text">
                            <span class="name">
                                {{ site.name }}
                                {% if not site.invoicingEnabled %}<span class="badge-nobill" title="Aucune facture n'est émise pour ce site">sans facture</span>{% endif %}
                            </span>
                            <span class="code">{{ site.domain }}</span>
                        </span>
                    </a>
                {% endfor %}
            </div>

            <p class="empty" id="site-empty" hidden>Aucun site ne correspond à votre recherche.</p>
        {% endif %}
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('site-filter');
        if (!input) return;

        var cards = Array.prototype.slice.call(document.querySelectorAll('.site-card'));
        var counter = document.getElementById('site-count');
        var empty = document.getElementById('site-empty');

        // Recherche insensible aux accents : taper "seminaire" doit trouver
        // "Séminaire".
        function normalize(value) {
            return value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
        }

        var haystacks = cards.map(function (card) {
            return normalize(card.dataset.search);
        });

        function filter() {
            var terms = normalize(input.value).split(/\s+/).filter(Boolean);
            var visible = 0;

            cards.forEach(function (card, index) {
                var matches = terms.every(function (term) {
                    return haystacks[index].indexOf(term) !== -1;
                });
                card.hidden = !matches;
                if (matches) visible++;
            });

            counter.textContent = visible + ' site' + (visible > 1 ? 's' : '')
                + (terms.length ? ' sur ' + cards.length : '');
            empty.hidden = visible !== 0;
        }

        input.addEventListener('input', filter);

        // Entrée ouvre le premier résultat : sur une longue liste, on tape trois
        // lettres et on valide sans toucher à la souris.
        input.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') return;
            var first = cards.find(function (card) { return !card.hidden; });
            if (first) window.location.href = first.href;
        });
    })();
</script>
{% endblock %}

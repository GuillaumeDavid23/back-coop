{% extends 'base.html.twig' %}

{% block title %}Connexion - CLCOM Events{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="card">
        <div class="brand" style="text-align:center;">
            <img src="{{ asset('images/logo.png') }}" alt="CLCOM Academy" style="max-width:180px;">
        </div>

        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="field">
                <label for="username">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="actions">
                <button type="submit" class="btn-primary">Connexion</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% extends 'sites/seminaire_ia/base.html.twig' %}

{% block title %}Récapitulatif{% endblock %}

{% block body %}
	<div class="container mt-5 mb-5">
		<div class="d-flex justify-content-center w-100 mb-5">
			<h2 class="edito-title w-100">
				<span class="line"></span>
				RÉCAPITULATIF
				<span class="line"></span>
			</h2>
		</div>

		<div class="card mb-4">
			<div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
				<div>
					<span class="text-muted d-block" style="font-size:13px">FORFAIT SÉLECTIONNÉ</span>
					<span class="fw-bold">{{ fareLabel }}</span>
				</div>
				<div class="text-end">
					<span class="fw-bold text-primary" style="font-size:26px">{{ amountExclTax|number_format(2, ',', ' ') }} € HT</span>
					<span class="text-muted d-block" style="font-size:13px">soit {{ amountInclTax|number_format(2, ',', ' ') }} € TTC (TVA 20 %)</span>
				</div>
			</div>
		</div>

		<div class="card">
			<div class="card-body p-4">
				{% set civilities = {'mme': 'Madame', 'm': 'Monsieur'} %}
				{% set categories = {'salarie': 'Salarié', 'tns': 'Travailleur non salarié'} %}
				{% set rooms = {'grand_lit': '1 grand lit', 'lits_separes': '2 lits séparés'} %}

				{% set recap_groups = [
					{title: 'Votre statut', rows: [
						{label: 'Statut', value: statusLabel},
						data.statut == 'cooperateur' ? {label: "Numéro de facture d'adhésion", value: data.subscriptionNumber} : null,
					]|filter(r => r is not null)},
					{title: 'Votre forfait', rows: [
						{label: 'Forfait', value: fare.label},
						fare.accommodation and isTwoPerson ? {label: 'Type de chambre', value: rooms[data.roomType]|default('—')} : null,
						data.eveningOption|default(false) ? {label: 'Soirée du jeudi 22 octobre', value: 'Oui'} : null,
					]|filter(r => r is not null)},
					{title: 'Participant', rows: [
						{label: 'Civilité', value: civilities[data.civility]|default('—')},
						{label: 'Nom', value: data.lastName},
						{label: 'Prénom', value: data.firstName},
						{label: 'Mobile', value: data.mobile},
						{label: 'Email', value: data.email},
						{label: 'Cabinet', value: data.company},
						{label: 'Catégorie', value: categories[data.category]|default('—')},
						{label: 'Adresse', value: data.address ~ ', ' ~ data.postalCode ~ ' ' ~ data.city},
					]},
				] %}
				{% if isTwoPerson %}
					{% set recap_groups = recap_groups|merge([
						{title: data.fare == 'heb_1ec_acc' ? 'Accompagnant' : '2ème Participant', rows: [
							{label: 'Civilité', value: civilities[data.civility2]|default('—')},
							{label: 'Nom', value: data.lastName2},
							{label: 'Prénom', value: data.firstName2},
							{label: 'Mobile', value: data.mobile2},
							{label: 'Email', value: data.email2},
							data.company2 ? {label: 'Cabinet', value: data.company2} : null,
							data.category2 ? {label: 'Catégorie', value: categories[data.category2]|default('—')} : null,
						]|filter(r => r is not null)},
					]) %}
				{% endif %}
				{% set recap_groups = recap_groups|merge([
					{title: 'Votre demande', rows: [
						{label: 'Motif de votre inscription et vos attentes', value: data.motivation},
						{label: 'Besoins spécifiques', value: data.specialNeeds|default('—')},
					]},
				]) %}

				{% set questionnaire_labels = {
					aiLevel: "Niveau d'utilisation de l'IA",
					aiFrequency: "Fréquence d'utilisation",
					paidSubscription: 'Abonnement payant',
					paidSubscriptionTools: 'Abonnement(s)',
					claudeUsage: 'Utilisation de Claude au cabinet',
					claudeLicense: 'Licence Claude pour les ateliers',
					priorityUseCases: "Cas d'usage prioritaires",
					dailyTools: 'Outils du quotidien',
					toolsToBuild: 'Outils à développer',
					timeConsumingTasks: 'Tâches les plus chronophages',
				} %}
				{% set questionnaire_rows = [] %}
				{% for key, label in questionnaire_labels %}
					{% if questionnaire[key] is defined and questionnaire[key] is not empty %}
						{% set value = questionnaire[key] is iterable ? questionnaire[key]|join(', ') : questionnaire[key] %}
						{% set questionnaire_rows = questionnaire_rows|merge([{label: label, value: value}]) %}
					{% endif %}
				{% endfor %}
				{% if questionnaire_rows is not empty %}
					{% set recap_groups = recap_groups|merge([{title: 'Questionnaire', rows: questionnaire_rows}]) %}
				{% endif %}

				{% for group in recap_groups %}
					<h3 class="text-primary {{ not loop.first ? 'mt-4' : '' }}">{{ group.title }}</h3>
					{% for row in group.rows %}
						<div class="row recap-row">
							<div class="col-md-5 text-muted">{{ row.label }}</div>
							<div class="col-md-7">{{ row.value }}</div>
						</div>
					{% endfor %}
				{% endfor %}

				<form method="post" action="{{ path('ia_registration_pay') }}" class="mt-4">
					<input type="hidden" name="_token" value="{{ csrf_token('ia_payment') }}" data-controller="csrf-protection">
					<p style="font-size:13.5px">
						En validant, vous serez redirigé vers notre plateforme de paiement sécurisée (carte bancaire — CLCOM Academy).
					</p>
					<div class="d-flex align-items-center gap-3 flex-wrap">
						<button type="submit" class="btn btn-primary text-white">Payer {{ amountInclTax|number_format(2, ',', ' ') }} € TTC</button>
						<a href="{{ path('ia_registration_step1') }}" class="btn btn-outline-primary">Modifier</a>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}

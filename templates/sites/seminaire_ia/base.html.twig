<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Séminaire IA | {% block title %}{% endblock %}</title>
    <link rel="icon" type="image/png" href="/images/sites/seminaire_ia/logo-clcom-academy.png">
    <link rel="apple-touch-icon" href="/images/sites/seminaire_ia/logo-clcom-academy.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind:wght@300;400;500;600;700&family=Playfair+Display:wght@700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/sites/seminaire_ia.css">
    <script type="module" src="/js/csrf-protection.js"></script>
</head>
<body>

    {# Volet latéral : même navigation que le site de référence, sans la
       rubrique "Activité" (activités détente supprimées pour cet événement). #}
    <div>
        <div id="openSidebar">
            <i class="fas fa-bars"></i>
        </div>

        <div id="sidebar">
            <a href="javascript:void(0)" class="closebtn" id="closeSidebar">&times;</a>

            <div class="sidebar-header">
                <div class="sidebar-title">Au programme</div>
            </div>

            <a href="{{ path('ia_home') }}#edito"><i class="fas fa-info-circle"></i>Edito</a>
            <a href="{{ path('ia_home') }}#formation"><i class="fas fa-graduation-cap"></i>Formation</a>
            <a href="{{ path('ia_home') }}#programme"><i class="fas fa-calendar-alt"></i>Programme</a>
            <a href="{{ path('ia_home') }}#inscription"><i class="fas fa-user-plus"></i>Inscription</a>
            <a href="{{ path('ia_home') }}#contact"><i class="fas fa-envelope"></i>Contact</a>
        </div>
    </div>

    {% block body %}{% endblock %}

    <footer class="text-center mt-5 pt-5">
        <div class="container">
            {# Logos organisateurs : sous le bloc contact, avant les pictogrammes. #}
            <div class="row mb-4">
                <div class="col-12 d-flex justify-content-center align-items-center gap-5 flex-wrap">
                    <img src="/images/sites/seminaire_ia/certifopac-logo.png" alt="Certif OPAC" height="70">
                    <img src="/images/sites/seminaire_ia/cofrac-logo.png" alt="COFRAC Essais — Accréditation n° 1-5879" height="70">
                </div>
            </div>
            <div class="row mb-5">
                <div class="col-12">
                    <a href="https://www.facebook.com/clcomevents" target="_blank" rel="noopener" class="mx-2"><img src="/images/sites/seminaire_ia/facebook.svg" alt="Facebook" height="17"></a>
                    <a href="https://www.linkedin.com/company/clcom/?viewAsMember=true" target="_blank" rel="noopener" class="mx-2"><img src="/images/sites/seminaire_ia/linkedin.svg" alt="LinkedIn" height="17"></a>
                    <a href="https://www.instagram.com/clcomevents/" target="_blank" rel="noopener" class="mx-2"><img src="/images/sites/seminaire_ia/instagram.svg" alt="Instagram" height="17"></a>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <p style="font-size: 13px; font-family: 'Roboto', sans-serif; color:#555555; font-weight: 300">&copy; {{ 'now'|date('Y') }} CLCOM Academy, tous droits réservés.</p>
                    <p style="font-size: 13px; font-family: 'Roboto', sans-serif; color:#555555; font-weight: 300">
                        <a class="text-decoration-underline" target="_blank" href="{{ path('ia_legal_notice') }}">Mentions légales</a>
                        -
                        <a class="text-decoration-underline" target="_blank" href="{{ path('ia_terms') }}">Conditions générales de vente</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <button class="back-to-top" id="backToTop" title="Go to top">
        <img src="/images/sites/seminaire_ia/chevron-up-solid.svg" alt="" width="25">
    </button>

    <script>
        // Volet latéral (équivalent du sidebar_controller Stimulus du site de référence).
        (function () {
            var sidebar = document.getElementById('sidebar');
            var openBtn = document.getElementById('openSidebar');
            var closeBtn = document.getElementById('closeSidebar');
            if (!sidebar || !openBtn) return;

            function open() { sidebar.style.width = window.innerWidth <= 768 ? '100%' : '250px'; }
            function close() { sidebar.style.width = '0'; }

            openBtn.addEventListener('click', open);
            if (closeBtn) closeBtn.addEventListener('click', close);
            sidebar.querySelectorAll('a:not(.closebtn)').forEach(function (link) {
                link.addEventListener('click', function () { setTimeout(close, 300); });
            });
        })();

        // Bouton "retour en haut".
        (function () {
            var button = document.getElementById('backToTop');
            if (!button) return;
            window.addEventListener('scroll', function () {
                button.style.display = window.scrollY > 20 ? 'block' : 'none';
            });
            button.addEventListener('click', function () {
                window.scrollTo({top: 0, behavior: 'smooth'});
            });
        })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>

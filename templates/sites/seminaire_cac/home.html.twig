{% extends 'sites/seminaire_cac/base.html.twig' %}

{% block body %}
<div>

    <section style="background:#FBF9F6">
        <picture>
            <source media="(max-width: 860px)" srcset="/images/sites/seminaire_cac/banner_mobile.png">
            <img src="/images/sites/seminaire_cac/hero-banner.png" alt="Séminaire CAC by La Coop' des Experts — Paris 24-25 novembre 2026" style="display:block;width:100%;height:auto">
        </picture>
    </section>

    <section style="background:#F6F0E8;border-top:1px solid #E4D8C6;border-bottom:1px solid #E4D8C6">
        <div style="max-width:1180px;margin:0 auto;padding:34px 28px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap">
            <div style="display:flex;flex-direction:column;gap:14px">
                <span style="font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.24em;color:#8A7A66;font-weight:600">PLUS QUE</span>
                <div class="sc-countdown-values" style="display:flex;align-items:flex-start;gap:32px">
                    <div style="display:flex;flex-direction:column;align-items:center;min-width:72px">
                        <span id="cd-days" style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:42px;line-height:1;color:#1E6685">–</span>
                        <span style="font-size:11px;letter-spacing:0.16em;color:#6B6B6B;margin-top:8px">JOURS</span>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:center;min-width:72px">
                        <span id="cd-hours" style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:42px;line-height:1;color:#1E6685">–</span>
                        <span style="font-size:11px;letter-spacing:0.16em;color:#6B6B6B;margin-top:8px">HEURES</span>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:center;min-width:72px">
                        <span id="cd-minutes" style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:42px;line-height:1;color:#1E6685">–</span>
                        <span style="font-size:11px;letter-spacing:0.16em;color:#6B6B6B;margin-top:8px">MINUTES</span>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:center;min-width:72px">
                        <span id="cd-seconds" style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:42px;line-height:1;color:#1E6685">–</span>
                        <span style="font-size:11px;letter-spacing:0.16em;color:#6B6B6B;margin-top:8px">SECONDES</span>
                    </div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
                <a href="#programme" class="sc-btn-primary">Découvrir le programme</a>
                <a href="#programme" class="sc-btn-outline"><span style="font-size:15px">↓</span>Télécharger la plaquette (PDF)</a>
            </div>
        </div>
    </section>

    <section id="edito" style="max-width:1180px;margin:0 auto;padding:92px 28px 0">
        <div class="sc-grid" style="display:grid;grid-template-columns:300px 1fr;gap:60px;align-items:start">
            <div style="display:flex;flex-direction:column;gap:26px">
                <div style="display:flex;flex-direction:column;gap:12px">
                    <img src="/images/sites/seminaire_cac/speaker-mallen.png" alt="Jean-François Mallen" style="width: 100%; height: 300px; object-fit: cover; border-radius: 4px; display: block; background: #F6F0E8">
                    <div style="display:flex;flex-direction:column;gap:2px">
                        <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px">Jean-François Mallen</span>
                        <span style="font-size:13px;color:#6B6B6B">Président CRCC Lyon-Riom</span>
                    </div>
                </div>
                <div style="display:flex;flex-direction:column;gap:12px">
                    <img src="/images/sites/seminaire_cac/speaker-merel.png" alt="Virginie Merel" style="width: 100%; height: 300px; object-fit: cover; border-radius: 4px; display: block; background: #F6F0E8">
                    <div style="display:flex;flex-direction:column;gap:2px">
                        <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px">Virginie Merel</span>
                        <span style="font-size:13px;color:#6B6B6B">Expert-Comptable, Commissaire aux comptes</span>
                    </div>
                </div>
            </div>
            <div>
                <span style="font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.24em;color:#8A7A66;font-weight:600">ÉDITO</span>
                <h2 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:34px;line-height:1.25;color:#1E6685;margin:14px 0 26px;max-width:22ch">Anticiper ensemble le commissariat aux comptes de demain</h2>
                <div style="display:flex;flex-direction:column;gap:18px;font-size:16px;line-height:1.75;color:#3A3A3A;max-width:66ch">
                    <p style="margin:0">Nous avons tous le même constat, notre métier évolue rapidement. Les normes changent, l'intelligence artificielle fait son entrée dans nos cabinets, la facture électronique transforme l'environnement de nos clients, de nouveaux référentiels apparaissent, …</p>
                    <p style="margin:0">Les sujets s'accumulent et, lorsque l'on exerce en cabinet libéral, il n'est pas toujours simple de savoir par où commencer, quelles priorités retenir ou comment préparer concrètement son cabinet. Il est parfois facile de se sentir seul face à toutes ces évolutions. C'est justement de ce constat qu'est née l'idée de ce séminaire.</p>
                    <p style="margin:0">Nous avons voulu construire une formation qui dépasse la simple actualisation des connaissances. Un temps pour prendre du recul, comprendre les grandes transformations qui se dessinent, échanger entre confrères et consœurs, partager nos expériences et repartir avec une feuille de route claire pour les mois à venir.</p>
                    <div id="edito-more" style="display:none; flex-direction:column; gap:18px;">
                        <p style="margin:0">Les 24 et 25 novembre, nous prendrons le temps d'aborder les sujets qui auront un impact direct sur notre exercice : l'évolution des NEP et leur convergence vers les ISA, les opportunités offertes par l'intelligence artificielle, le référentiel VSME, la facture électronique… avec une approche résolument pratique et tournée vers nos cabinets.</p>
                        <p style="margin:0">Nous nous retrouverons ensuite le 15 décembre, en classe virtuelle, pour faire le point sur les dernières actualités de la profession. L'objectif est que chacun puisse démarrer la prochaine campagne d'audit avec les bons repères, les bons outils et une vision actualisée des enjeux.</p>
                        <p style="margin:0">Les responsabilités que nous exerçons au sein de nos CRCC et du Conseil national nous donnent l'opportunité d'être au cœur des réflexions qui préparent l'avenir de notre profession. Nous avons souhaité mettre cette expérience au service des confrères et des consœurs, non pour délivrer des certitudes, mais pour partager cette visibilité, décrypter les évolutions qui se préparent et vous aider à les anticiper avec confiance.</p>
                        <p style="margin:0">Au-delà du contenu technique, nous souhaitons que ce séminaire soit aussi un moment de rencontres. Parce que les meilleures idées naissent souvent d'un échange de pause-café, d'un retour d'expérience ou d'une discussion entre confrères confrontés aux mêmes questions. Le cocktail apéritif organisé entre les deux journées de présentiel prolongera ces moments de partage dans une ambiance conviviale.</p>
                        <p style="margin:0">Notre profession a toujours su évoluer. Nous sommes convaincus qu'elle continuera à le faire si nous prenons le temps de réfléchir ensemble aux défis qui nous attendent. Nous espérons vous retrouver nombreux pour ces trois temps de formation, d'échanges et de convivialité.</p>
                    </div>
                </div>
                <button type="button" id="edito-toggle" style="margin-top:22px;background:none;border:0;border-bottom:1px solid #1E6685;padding:0 0 3px;cursor:pointer;font-family:'Montserrat',sans-serif;font-weight:600;font-size:14px;color:#1E6685">Lire la suite</button>
            </div>
        </div>
    </section>

    <section id="programme" style="max-width:1180px;margin:0 auto;padding:92px 28px 0">
        <span style="font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.24em;color:#8A7A66;font-weight:600">PROGRAMME</span>
        <h2 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:32px;color:#1E6685;margin:12px 0 30px">Deux jours en présentiel, une classe virtuelle</h2>
        <div class="sc-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch">
            <div style="border:1px solid #E4D8C6;border-radius:4px;background:#fff;overflow:hidden;display:flex;flex-direction:column">
                <div style="background:#1E6685;color:#fff;padding:18px 26px;display:flex;align-items:center;justify-content:space-between;gap:16px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:14px;letter-spacing:0.1em">JOUR 1 — MARDI 24 NOVEMBRE</span>
                </div>
                <div style="padding:30px 30px 34px;flex:1">
                    {% for slot in day1 %}
                        <div style="display:grid;grid-template-columns:16px 1fr;gap:20px;position:relative">
                            <div style="display:flex;flex-direction:column;align-items:center">
                                <span style="width:11px;height:11px;border-radius:50%;background:#1E6685;margin-top:5px;flex:none"></span>
                                <span style="width:1px;flex:1;background:#DDE7EB;margin:6px 0"></span>
                            </div>
                            <div style="padding-bottom:26px;display:flex;flex-direction:column;gap:6px">
                                <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:13.5px;letter-spacing:0.05em;color:#1E6685">{{ slot.time }}</span>
                                <span style="font-size:15.5px;line-height:1.5;color:#2E2E2E">{{ slot.label }}</span>
                                <span style="font-size:10.5px;letter-spacing:0.16em;color:#A79B87">{{ slot.tag }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div style="border:1px solid #E4D8C6;border-radius:4px;background:#fff;overflow:hidden;display:flex;flex-direction:column">
                <div style="background:#123C4F;color:#fff;padding:18px 26px;display:flex;align-items:center;justify-content:space-between;gap:16px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:14px;letter-spacing:0.1em">JOUR 2 — MERCREDI 25 NOVEMBRE</span>
                </div>
                <div style="padding:30px 30px 34px;flex:1">
                    {% for slot in day2 %}
                        <div style="display:grid;grid-template-columns:16px 1fr;gap:20px;position:relative">
                            <div style="display:flex;flex-direction:column;align-items:center">
                                <span style="width:11px;height:11px;border-radius:50%;background:#123C4F;margin-top:5px;flex:none"></span>
                                <span style="width:1px;flex:1;background:#DDE7EB;margin:6px 0"></span>
                            </div>
                            <div style="padding-bottom:26px;display:flex;flex-direction:column;gap:6px">
                                <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:13.5px;letter-spacing:0.05em;color:#123C4F">{{ slot.time }}</span>
                                <span style="font-size:15.5px;line-height:1.5;color:#2E2E2E">{{ slot.label }}</span>
                                <span style="font-size:10.5px;letter-spacing:0.16em;color:#A79B87">{{ slot.tag }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="sc-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px">
            <div style="display:flex;align-items:center;gap:20px;background:#F6F0E8;border-radius:4px;padding:24px 28px">
                <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:34px;color:#1E6685;line-height:1">16h</span>
                <span style="font-size:16px;line-height:1.5;color:#3A3A3A">Total heures de formation<br>en présentiel</span>
            </div>
            <div style="display:flex;align-items:center;gap:20px;background:#1E6685;border-radius:4px;padding:24px 28px;color:#fff">
                <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:34px;line-height:1">4h</span>
                <span style="font-size:16px;line-height:1.5">Pour compléter votre parcours, 4h de formation<br>en distanciel le mardi 15 décembre</span>
            </div>
        </div>
    </section>

    <section id="lieu" style="max-width:1180px;margin:0 auto;padding:92px 28px 0">
        <span style="font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.24em;color:#8A7A66;font-weight:600">LE LIEU</span>
        <h2 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:32px;color:#1E6685;margin:12px 0 30px">Crowne Plaza République</h2>
        <div class="sc-grid" style="display:grid;grid-template-columns:1.35fr 1fr;gap:20px">
            <img src="/images/sites/seminaire_cac/venue-cour-interieure.jpg" alt="Cour intérieure du Crowne Plaza République" style="width:100%;height:420px;object-fit:cover;border-radius:4px">
            <div style="display:flex;flex-direction:column;gap:20px">
                <img src="/images/sites/seminaire_cac/venue-restaurant.png" alt="Restaurant du Crowne Plaza République" style="width:100%;height:200px;object-fit:cover;border-radius:4px">
                <div style="flex:1;background:#F6F0E8;border-radius:4px;padding:26px 28px;display:flex;flex-direction:column;gap:14px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:16px;color:#1E6685">Crowne Plaza République</span>
                    <span style="font-size:15px;line-height:1.6;color:#3A3A3A">10 Place de la République, 75011 Paris</span>
                    <a href="https://www.ihg.com/crowneplaza" target="_blank" rel="noopener" style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:14px">Voir le lieu →</a>
                </div>
            </div>
        </div>
    </section>

    <section id="inscription" style="max-width:1180px;margin:0 auto;padding:92px 28px 0">
        <span style="font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.24em;color:#8A7A66;font-weight:600">TARIFS</span>
        <h2 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:32px;color:#1E6685;margin:12px 0 8px">Choisissez votre forfait</h2>
        <div class="sc-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch">
            {% for code, fare in fares %}
                <div class="sc-fare-card" style="border:1px solid #E4D8C6;border-radius:4px;background:#fff;display:flex;flex-direction:column;overflow:hidden">
                    <div style="background:#1E6685;color:#fff;padding:16px 24px;text-align:center;font-family:'Montserrat',sans-serif;font-weight:600;font-size:13px;letter-spacing:0.1em;min-height:66px;display:flex;align-items:center;justify-content:center">{{ fare.label|upper }}</div>
                    <div style="padding:28px 26px;display:flex;flex-direction:column;gap:22px;flex:1">
                        <div style="display:flex;align-items:baseline;gap:8px;justify-content:center">
                            <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:40px;color:#1E6685;line-height:1">{{ fare.amount|number_format(0, ',', ' ') }} €</span>
                            <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:14px;color:#6B6B6B">HT</span>
                        </div>
                        <div style="height:1px;background:#F1E9DC"></div>
                        <div style="display:flex;flex-direction:column;gap:14px;font-size:16.5px;line-height:1.5;color:#3A3A3A">
                            <div style="display:flex;gap:10px"><span style="color:#1E6685">✓</span>Formation en présentiel</div>
                            <div style="display:flex;gap:10px"><span style="color:#1E6685">✓</span>Formation en distanciel</div>
                            <div style="display:flex;gap:10px"><span style="color:#1E6685">✓</span>Café d'accueil, pauses et déjeuners</div>
                            <div style="display:flex;gap:10px"><span style="color:#1E6685">✓</span>Cocktail apéritif du mardi</div>
                        </div>
                        <a href="{{ path('cac_registration_step1', {fare: code}) }}" class="sc-btn-primary" style="margin-top:auto; text-align:center; width:100%;">Choisir ce forfait</a>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div style="margin-top:46px;border:1px solid #E4D8C6;border-radius:4px;overflow:hidden">
            <div style="background:#F6F0E8;padding:16px 30px">
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:13px;letter-spacing:0.12em;color:#1E6685">CONDITIONS D'ANNULATION</span>
            </div>
            <div class="sc-grid" style="display:grid;grid-template-columns:repeat(3,1fr);background:#FBF9F6">
                <div style="padding:30px 30px 32px;border-right:1px solid #EDE4D8;display:flex;flex-direction:column;gap:10px">
                    <div style="display:flex;align-items:baseline;gap:10px">
                        <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:36px;line-height:1;color:#1E6685">30</span>
                        <span style="font-size:12px;letter-spacing:0.1em;color:#8A7A66">JOURS AVANT</span>
                    </div>
                    <span style="height:2px;width:36px;background:#1E6685"></span>
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px;color:#2E2E2E">Remboursement intégral</span>
                    <span style="font-size:14px;line-height:1.6;color:#3A3A3A">L'intégralité des sommes versées vous est restituée, sans frais de dossier.</span>
                </div>
                <div style="padding:30px 30px 32px;border-right:1px solid #EDE4D8;display:flex;flex-direction:column;gap:10px">
                    <div style="display:flex;align-items:baseline;gap:10px">
                        <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:36px;line-height:1;color:#1E6685">29–15</span>
                        <span style="font-size:12px;letter-spacing:0.1em;color:#8A7A66">JOURS AVANT</span>
                    </div>
                    <span style="height:2px;width:36px;background:#1E6685"></span>
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px;color:#2E2E2E">Remboursement de 50 %</span>
                    <span style="font-size:14px;line-height:1.6;color:#3A3A3A">La moitié du montant de l'inscription reste acquise à l'organisateur.</span>
                </div>
                <div style="padding:30px 30px 32px;display:flex;flex-direction:column;gap:10px">
                    <div style="display:flex;align-items:baseline;gap:10px">
                        <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:36px;line-height:1;color:#C9835A">14</span>
                        <span style="font-size:12px;letter-spacing:0.1em;color:#8A7A66">JOURS AVANT</span>
                    </div>
                    <span style="height:2px;width:36px;background:#C9835A"></span>
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px;color:#2E2E2E">Aucun remboursement</span>
                    <span style="font-size:14px;line-height:1.6;color:#3A3A3A">L'inscription reste due. Le remplacement du participant est possible sans frais.</span>
                </div>
            </div>
        </div>
    </section>

    <section id="cooperateur" style="background:#F6F0E8;margin-top:72px">
        <div class="sc-grid" style="max-width:1180px;margin:0 auto;padding:48px 28px;display:grid;grid-template-columns:1fr 1.3fr;gap:56px;align-items:start">
            <div style="display:flex;flex-direction:column;gap:16px">
                <img src="/images/sites/seminaire_cac/logo-coop.png" alt="La Coop' des Experts" style="width:44px;height:auto">
                <h2 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:24px;color:#1E6685;margin:0;line-height:1.3">Devenir coopérateur</h2>
                <p style="margin:0;font-size:14.5px;line-height:1.65;color:#5A5A5A">La Coop' des Experts est une coopérative qui nourrit l'ambition de permettre à l'ensemble des cabinets de bénéficier d'outils innovants à tarif préférentiel par la mutualisation.</p>
                <a href="#contact" style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:13.5px">En savoir plus →</a>
            </div>
            <div class="sc-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:28px 32px">
                <div style="display:flex;flex-direction:column;gap:6px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px;color:#C9A87C">01</span>
                    <span style="font-size:14px;line-height:1.55;color:#3A3A3A">Être informé de l'actualité et des évolutions de la coopérative pour mieux vous accompagner</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px;color:#C9A87C">02</span>
                    <span style="font-size:14px;line-height:1.55;color:#3A3A3A">Échanger avec les coopérateurs dans le cadre d'un réseau informel de professionnels</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px;color:#C9A87C">03</span>
                    <span style="font-size:14px;line-height:1.55;color:#3A3A3A">Contacter des correspondants spécialisés pour vos questions CAC, fiscal, social, déontologie, etc. via notre Forum</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px;color:#C9A87C">04</span>
                    <span style="font-size:14px;line-height:1.55;color:#3A3A3A">Partager des moments de convivialité</span>
                </div>
            </div>
        </div>
    </section>

    <section style="background:#1E6685">
        <div style="max-width:1180px;margin:0 auto;padding:46px 28px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap">
            <div style="display:flex;flex-direction:column;gap:8px;color:#fff">
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:26px">Prêt à nous rejoindre ?</span>
                <span style="font-size:15px;opacity:0.85">Les 24 et 25 novembre 2026 à Paris, puis le 15 décembre en classe virtuelle.</span>
            </div>
            <a href="#inscription" style="border:0;cursor:pointer;background:#fff;color:#1E6685;font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px;padding:16px 32px;border-radius:999px;text-decoration:none">Je m'inscris dès maintenant</a>
        </div>
    </section>

</div>

<script>
(function () {
    var target = new Date("2026-11-24T08:30:00+01:00").getTime();
    function pad(n) { return String(n).padStart(2, "0"); }
    function tick() {
        var diff = Math.max(0, target - Date.now());
        document.getElementById("cd-days").textContent = Math.floor(diff / 86400000);
        document.getElementById("cd-hours").textContent = pad(Math.floor(diff / 3600000) % 24);
        document.getElementById("cd-minutes").textContent = pad(Math.floor(diff / 60000) % 60);
        document.getElementById("cd-seconds").textContent = pad(Math.floor(diff / 1000) % 60);
    }
    tick();
    setInterval(tick, 1000);

    var toggle = document.getElementById("edito-toggle");
    var more = document.getElementById("edito-more");
    toggle.addEventListener("click", function () {
        var open = more.style.display === "flex";
        more.style.display = open ? "none" : "flex";
        toggle.textContent = open ? "Lire la suite" : "Réduire";
    });
})();
</script>
{% endblock %}

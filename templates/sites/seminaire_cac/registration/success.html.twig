{% extends 'sites/seminaire_cac/base.html.twig' %}

{% block title %}Inscription confirmée - Séminaire CAC{% endblock %}

{% block body %}
<section style="background:#FBF9F6;border-bottom:1px solid #EDE4D8">
    <div style="max-width:940px;margin:0 auto;padding:70px 28px 84px">

        <div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px">
            <span style="width:74px;height:74px;border-radius:50%;background:#1E6685;display:flex;align-items:center;justify-content:center">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            <h1 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:34px;color:#1E6685;margin:0">
                {% if participant %}Merci {{ participant.firstName }}, votre inscription est enregistrée{% else %}Merci, votre inscription est enregistrée{% endif %}
            </h1>
            <p style="margin:0;max-width:620px;font-size:16px;line-height:1.75;color:#3A3A3A">
                {% if isConfirmed %}
                    Votre paiement a bien été encaissé. Un email de confirmation vient de vous être envoyé{% if participant %} à <strong>{{ participant.email }}</strong>{% endif %}, avec votre facture en pièce jointe.
                {% else %}
                    Votre paiement est en cours de validation par notre prestataire bancaire. Dès qu'il est confirmé, un email récapitulatif vous est envoyé{% if participant %} à <strong>{{ participant.email }}</strong>{% endif %}, accompagné de votre facture.
                {% endif %}
            </p>
            {% if participant %}
                <span style="font-size:14px;color:#6B6B6B">Pensez à vérifier vos courriers indésirables si vous ne le recevez pas.</span>
            {% endif %}
        </div>

        {% if registration %}
            <div style="margin-top:44px;border:1px solid #E4D8C6;border-radius:4px;overflow:hidden;background:#fff">
                <div style="background:#F6F0E8;padding:15px 28px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:12.5px;letter-spacing:0.14em;color:#1E6685">VOTRE INSCRIPTION</span>
                </div>
                <div class="sc-grid" style="display:grid;grid-template-columns:repeat(3,1fr)">
                    <div style="padding:24px 28px;border-right:1px solid #EDE4D8;display:flex;flex-direction:column;gap:6px">
                        <span style="font-size:12px;letter-spacing:0.08em;color:#8A7A66">RÉFÉRENCE</span>
                        <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:17px;color:#2E2E2E">N° {{ registration.id }}</span>
                    </div>
                    <div style="padding:24px 28px;border-right:1px solid #EDE4D8;display:flex;flex-direction:column;gap:6px">
                        <span style="font-size:12px;letter-spacing:0.08em;color:#8A7A66">FORFAIT</span>
                        <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:17px;color:#2E2E2E">{{ registration.fareLabel }}</span>
                    </div>
                    <div style="padding:24px 28px;display:flex;flex-direction:column;gap:6px">
                        <span style="font-size:12px;letter-spacing:0.08em;color:#8A7A66">MONTANT</span>
                        <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:17px;color:#2E2E2E">{{ registration.amountInclTax|number_format(2, ',', ' ') }} € TTC</span>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="sc-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px">
            <div style="background:#fff;border:1px solid #E4D8C6;border-radius:4px;padding:26px 28px;display:flex;flex-direction:column;gap:12px">
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px;color:#1E6685">Rendez-vous les 24 &amp; 25 novembre 2026</span>
                <span style="font-size:14.5px;line-height:1.7;color:#3A3A3A">
                    Crowne Plaza République<br>
                    10 Place de la République, 75011 Paris<br>
                    Accueil café dès 8h30.
                </span>
                <span style="font-size:14.5px;line-height:1.7;color:#3A3A3A">
                    4h de formation en distanciel le 15 décembre.
                </span>
                <a href="{{ path('cac_registration_ics') }}" class="sc-btn-outline" style="margin-top:6px;align-self:flex-start">Ajouter à mon agenda</a>
            </div>

            <div style="background:#fff;border:1px solid #E4D8C6;border-radius:4px;padding:26px 28px;display:flex;flex-direction:column;gap:12px">
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:15px;color:#1E6685">Et maintenant ?</span>
                <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px;line-height:1.6;color:#3A3A3A">
                    <div style="display:flex;gap:10px"><span style="color:#1E6685">1.</span>Vous recevez votre confirmation d'inscription et votre facture par email.</div>
                    <div style="display:flex;gap:10px"><span style="color:#1E6685">2.</span>Le programme détaillé et les informations pratiques vous seront adressés avant l'événement.</div>
                    <div style="display:flex;gap:10px"><span style="color:#1E6685">3.</span>Le lien de connexion pour la session en distanciel vous parviendra début décembre.</div>
                </div>
            </div>
        </div>

        <div style="margin-top:20px;background:#F6F0E8;border-radius:4px;padding:22px 28px;font-size:14.5px;line-height:1.7;color:#3A3A3A">
            Une question, une erreur dans vos informations ou un aménagement particulier à signaler ?
            Contactez Lola BOYER au <a href="tel:0478084274">04 78 08 42 74</a> ou <a href="mailto:l.boyer@clcom.fr">l.boyer@clcom.fr</a>.
        </div>

        <div style="display:flex;justify-content:center;gap:16px;margin-top:34px;flex-wrap:wrap">
            <a href="{{ path('cac_home') }}" class="sc-btn-outline">← Retour à l'accueil</a>
            <a href="{{ path('cac_home') }}#programme" class="sc-btn-primary">Revoir le programme</a>
        </div>

    </div>
</section>
{% endblock %}

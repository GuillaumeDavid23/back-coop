{% extends 'sites/seminaire_cac/base.html.twig' %}

{% block title %}Récapitulatif - Séminaire CAC{% endblock %}

{% block body %}
<section style="background:#FBF9F6;border-bottom:1px solid #EDE4D8">
    <div style="max-width:900px;margin:0 auto;padding:56px 28px 76px">
        <a href="{{ path('cac_registration_step1') }}" style="display:block;background:none;border:0;padding:0;cursor:pointer;font-family:'Montserrat',sans-serif;font-weight:600;font-size:13px;color:#1E6685;margin-bottom:26px;text-decoration:none">← Modifier mes informations</a>
        <div style="display:flex;align-items:center;gap:18px;margin-bottom:26px">
            <div style="display:flex;align-items:center;gap:11px">
                <span style="width:26px;height:26px;border-radius:50%;background:#DDE7EB;color:#1E6685;display:flex;align-items:center;justify-content:center;font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px">✓</span>
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:13px;color:#7FA2B2">Vos informations</span>
            </div>
            <span style="flex:1;max-width:90px;height:1px;background:#1E6685"></span>
            <div style="display:flex;align-items:center;gap:11px">
                <span style="width:26px;height:26px;border-radius:50%;background:#1E6685;color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Montserrat',sans-serif;font-weight:700;font-size:12px">2</span>
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:13px;color:#1E6685">Récapitulatif</span>
            </div>
        </div>
        <span style="display:block;font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.24em;color:#8A7A66;font-weight:600">RÉCAPITULATIF</span>
        <h1 style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:34px;color:#1E6685;margin:12px 0 28px">Vérifiez votre inscription</h1>

        <div style="background:#fff;border:1px solid #E4D8C6;border-radius:4px;padding:22px 26px;display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:22px;flex-wrap:wrap">
            <div style="display:flex;flex-direction:column;gap:4px">
                <span style="font-size:12px;letter-spacing:0.14em;color:#8A7A66;font-family:'Montserrat',sans-serif;font-weight:600">FORFAIT SÉLECTIONNÉ</span>
                <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:17px;color:#2E2E2E">{{ fare.label }}</span>
            </div>
            <div style="display:flex;align-items:baseline;gap:8px">
                <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:30px;color:#1E6685">{{ fare.amount|number_format(0, ',', ' ') }} €</span>
                <span style="font-size:13px;color:#6B6B6B;font-weight:600">HT</span>
            </div>
        </div>

        <div style="background:#fff;border:1px solid #E4D8C6;border-radius:4px;padding:34px;display:flex;flex-direction:column;gap:30px">
            {% set recap_groups = [
                {title: 'PARTICIPANT', rows: [
                    {label: 'Civilité', value: data.civility == 'mme' ? 'Madame' : 'Monsieur'},
                    {label: 'Nom', value: data.lastName},
                    {label: 'Prénom', value: data.firstName},
                    {label: 'Mobile', value: data.mobile},
                    {label: 'Email', value: data.email},
                ]},
                {title: 'CABINET', rows: [
                    {label: 'Cabinet', value: data.company},
                    {label: 'Adresse', value: data.address},
                    {label: 'Code postal', value: data.postalCode},
                    {label: 'Ville', value: data.city},
                    {label: 'Statut', value: data.status == 'salarie' ? 'Salarié' : 'Travailleur non salarié'},
                ]},
                {title: 'VOTRE DEMANDE', rows: [
                    {label: 'Motif de votre inscription et vos attentes', value: data.motivation},
                    {label: 'Besoins spécifiques', value: data.specialNeeds|default('-')|default('-')},
                ]},
                {title: 'COCKTAIL APÉRITIF', rows: [
                    {label: "Présence au cocktail du mardi", value: data.cocktailAttendance == 'oui' ? 'Oui' : 'Non'},
                ]},
            ] %}
            {% for group in recap_groups %}
                <div style="display:flex;flex-direction:column;gap:16px">
                    <span style="font-family:'Montserrat',sans-serif;font-weight:600;font-size:13px;letter-spacing:0.14em;color:#1E6685">{{ group.title }}</span>
                    <div style="display:flex;flex-direction:column">
                        {% for row in group.rows %}
                            <div class="sc-grid" style="display:grid;grid-template-columns:1fr 1.3fr;gap:24px;padding:12px 0;border-bottom:1px solid #F1E9DC;align-items:baseline">
                                <span style="font-size:14px;line-height:1.6;color:#8A7A66">{{ row.label }}</span>
                                <span style="font-size:15px;line-height:1.6;color:#2E2E2E">{{ row.value }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            <form method="post" action="{{ path('cac_registration_pay') }}" style="display:flex;flex-direction:column;gap:22px">
                {% for message in app.flashes('cac_notice') %}
                    <div style="background:#FDECEB;border:1px solid #F0B8B3;color:#A3352C;padding:12px 16px;border-radius:4px;font-size:14px">{{ message }}</div>
                {% endfor %}
                <input type="hidden" name="_token" value="{{ csrf_token('cac_payment') }}" data-controller="csrf-protection">
                <label style="display:flex;gap:12px;align-items:flex-start;font-size:14px;line-height:1.6;color:#3A3A3A">
                    <input type="checkbox" name="terms_accepted" value="1" required style="margin-top:4px;width:16px;height:16px;accent-color:#1E6685">
                    <span>J'accepte les conditions générales de vente et les conditions d'annulation</span>
                </label>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
                    <a href="{{ path('cac_registration_step1') }}" class="sc-btn-outline">Précédent</a>
                    <button type="submit" class="sc-btn-primary" style="padding:16px 34px;font-size:15px;">Valider mon inscription</button>
                </div>
            </form>
        </div>
    </div>
</section>
{% endblock %}

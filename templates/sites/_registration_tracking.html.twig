{# Suivi du parcours (voir AbstractRegistrationTrackingController) : uniquement
   des noms de champs et un nombre de champs remplis, jamais le contenu saisi.
   Paramètres : url (route de suivi du site), step (questionnaire ou formulaire). #}
<script>
    (function () {
        var form = document.querySelector('form[name="questionnaire"], form[name="registration_step1"]');
        if (!form || !navigator.sendBeacon) return;

        var url = '{{ url|e('js') }}';
        var step = '{{ step|e('js') }}';
        var visit = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
        var started = false, submitted = false, abandoned = false, blocked = [], timer = null;

        function send(event, extra) {
            var data = new URLSearchParams(extra || {});
            data.set('event', event);
            data.set('step', step);
            data.set('visit', visit);
            navigator.sendBeacon(url, data);
        }

        function fieldName(element) {
            var match = /\[([^\]]+)\]/.exec(element.name || '');
            return match ? match[1] : '';
        }

        function filledCount() {
            var names = {};
            Array.prototype.forEach.call(form.elements, function (element) {
                var name = fieldName(element);
                if (!name || ['hidden', 'submit', 'button'].indexOf(element.type) !== -1) return;
                var isCheck = element.type === 'checkbox' || element.type === 'radio';
                if (isCheck ? element.checked : element.value.trim() !== '') names[name] = true;
            });
            return Object.keys(names).length;
        }

        send('view');

        form.addEventListener('input', function () {
            if (started) return;
            started = true;
            send('started');
        });

        // "invalid" est émis pour chaque champ refusé par le navigateur, sans
        // jamais atteindre le serveur : on regroupe ceux d'un même clic.
        form.addEventListener('invalid', function (event) {
            var name = fieldName(event.target);
            if (name && blocked.indexOf(name) === -1) blocked.push(name);
            clearTimeout(timer);
            timer = setTimeout(function () {
                send('blocked', {fields: blocked.join(','), filled: filledCount()});
                blocked = [];
            }, 100);
        }, true);

        form.addEventListener('submit', function () {
            submitted = true;
        });

        function leave() {
            if (!started || submitted || abandoned) return;
            abandoned = true;
            send('abandoned', {filled: filledCount()});
        }

        // À la fermeture d'un onglet, "pagehide" arrive trop tard pour que
        // l'envoi parte. Le passage en arrière-plan est plus fiable, mais se
        // déclenche aussi sur un simple changement d'onglet : "abandoned" se
        // lit donc comme "a quitté la page au moins une fois".
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') leave();
        });
        window.addEventListener('pagehide', leave);
    })();
</script>

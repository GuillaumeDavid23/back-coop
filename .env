# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> app/sites ###
# Domaine du premier site événement. En local, ajouter dans le fichier
# hosts de la machine : "127.0.0.1 seminaire-cac.clcomevents.fr" puis
# ouvrir http://seminaire-cac.clcomevents.fr:8080/
SEMINAIRE_CAC_DOMAIN=seminaire-cac.clcomevents.fr
# Séminaire IA Deauville (CLCOM Academy). En local, ajouter dans le fichier
# hosts : "127.0.0.1 seminaire-ia.clcomevents.fr" puis ouvrir
# http://seminaire-ia.clcomevents.fr:8080/
SEMINAIRE_IA_DOMAIN=seminaire-ia.clcomevents.fr
###< app/sites ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# Valeur par défaut : surchargée par docker-compose.yml (service "db") en dev.
DATABASE_URL="mysql://clcom:clcom_secret@db:3306/clcom_events?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=no-reply@clcomevents.fr
# Recette en production : tant que cette variable est renseignée, TOUS les
# emails (participant, copies, copies cachées) sont livrés à ces adresses au
# lieu des destinataires réels — séparer par des virgules pour en mettre
# plusieurs. Les en-têtes d'origine restent visibles dans le message reçu.
# Vider la variable rétablit les envois normaux, sans vidage de cache (valeur
# lue à l'exécution) ; regénérer .env.local.php si "composer dump-env" est utilisé.
MAILER_TEST_RECIPIENTS=
###< symfony/mailer ###

###> knplabs/knp-snappy-bundle ###
# En prod IONOS, remplacer par le vrai chemin du binaire uploadé dans
# l'espace utilisateur (ex: /kunden/homepages/.../htdocs/usr/local/bin/wkhtmltopdf)
# dans .env.local — wkhtmltopdf n'est pas fourni par défaut sur le mutualisé,
# il faut l'uploader soi-même (binaire statique, sans besoin de root).
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf
###< knplabs/knp-snappy-bundle ###

###> stripe/stripe-php ###
# Valeurs réelles à définir dans .env.local (jamais commité). En dev, clés
# de test Stripe (préfixe sk_test_/pk_test_) ; en prod, vraies clés live.
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_PUBLIC_KEY=pk_test_changeme
# Obtenu via `stripe listen --print-secret` en local, ou dans le dashboard
# Stripe > Webhooks en prod. Sans cette valeur correcte, la vérification de
# signature du webhook échoue systématiquement (voir StripeWebhookController).
STRIPE_WEBHOOK_SECRET=whsec_changeme
###< stripe/stripe-php ###

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###

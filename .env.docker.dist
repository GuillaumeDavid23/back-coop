# Copier en .env.docker pour personnaliser l'environnement de dev local.
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=clcom_events
MYSQL_USER=clcom
MYSQL_PASSWORD=clcom_secret

APP_PORT=8080
DB_PORT=3307
MAILPIT_UI_PORT=8025
PHPMYADMIN_PORT=8081

# IMPORTANT : si plusieurs projets Docker tournent en parallèle sur cette
# machine (ex: le futur site Séminaire CAC développé à côté), donnez à
# CHAQUE projet des valeurs différentes ci-dessus pour éviter les conflits
# de ports, en plus d'un nom de projet Compose distinct (voir "name:" dans
# docker-compose.yml).

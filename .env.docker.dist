# Copier en .env.docker pour l'usage local (docker compose --env-file .env.docker up)
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=back_coop
MYSQL_USER=back_coop
MYSQL_PASSWORD=back_coop_secret

APP_PORT=8080
PHPMYADMIN_PORT=8081
DB_PORT=3307

# IMPORTANT : si vous faites tourner plusieurs projets Docker en parallèle
# (ex: cette passerelle + le back-office d'un nouveau site), donnez à CHAQUE
# projet des valeurs différentes ci-dessus pour éviter les conflits de ports.
# Le nom de projet Docker Compose ("name:" dans docker-compose.yml) doit
# aussi être différent d'un projet à l'autre.
